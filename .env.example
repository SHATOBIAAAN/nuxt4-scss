# Все переменные ниже читает запущенный сервер: один собранный .output поднимается
# и на стенде, и на проде с разными значениями. Пересборка нужна только для
# `pnpm generate` — там страницы, sitemap и robots запекаются в статику.

# Адрес сайта: canonical, og:url, sitemap.xml, robots.txt. Без него прод-сервер
# не стартует (server/plugins/site-url.ts), иначе ссылки строились бы из заголовка Host.
NUXT_PUBLIC_SITE_URL=https://example.com

# Название и описание по умолчанию (title, og:site_name, meta description).
# NUXT_PUBLIC_SITE_NAME=Название сайта
# NUXT_PUBLIC_SITE_DESCRIPTION=Описание сайта

# Всё, кроме production, закрывает сайт от индексации: robots.txt «Disallow: /»
# и X-Robots-Tag: noindex. На стенде ставить staging.
# NUXT_PUBLIC_SITE_ENV=staging

# Точка входа API. По умолчанию '/api' — BFF-слой в server/api; внешний бэкенд
# подставляется здесь, его origin автоматически попадает в CSP connect-src.
# NUXT_PUBLIC_API_PREFIX=https://api.example.com/v1

# CSP: режим выката новой политики (нарушения только в отчёт) и адрес для отчётов.
# NUXT_CSP_REPORT_ONLY=true
# NUXT_CSP_REPORT_URI=https://example.com/csp-report
