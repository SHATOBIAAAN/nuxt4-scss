{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "ignorePatterns": [
    ".nuxt",
    ".output",
    ".data",
    "dist",
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
